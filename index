<script>
const history=[];

function addMsg(html,role){
  const msgs=document.getElementById("msgs");
  const el=document.createElement("div");
  el.className="msg "+role;
  const inner=document.createElement("span");
  inner.innerHTML=html;
  el.appendChild(inner);
  msgs.appendChild(el);
  msgs.scrollTop=msgs.scrollHeight;
  return inner;
}

function sendQ(t){document.getElementById("inp").value=t;send();}

async function send(){
  const inp=document.getElementById("inp");
  const btn=document.getElementById("sendbtn");
  const q=inp.value.trim();
  if(!q||btn.disabled)return;
  inp.value="";
  btn.disabled=true;

  addMsg(q,"user");
  history.push({role:"user",content:q});

  // loading message
  const loading=document.createElement("div");
  loading.className="msg bot";
  
  loading.style.color="var(--text-2)";
  loading.innerHTML="Give me a New York minute.";
  document.getElementById("msgs").appendChild(loading);
  document.getElementById("msgs").scrollTop=9999;

  let dotCount=1;
  const dotInterval=setInterval(()=>{
    dotCount=(dotCount%3)+1;
    loading.innerHTML="Give me a New York minute"+".".repeat(dotCount);
  },400);

  try{
    const res=await fetch("/api/chat",{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({messages:history})
    });
    const data=await res.json();
    const reply=data.content||"Something went wrong.";
    clearInterval(dotInterval);
    
    loading.style.color="";
    loading.innerHTML=reply.replace(/\*(.*?)\*/g,"<em>$1</em>");
    history.push({role:"assistant",content:reply});
  }catch(e){
    clearInterval(dotInterval);
    loading.innerHTML="Connection error. Is the server running?";
  }

  btn.disabled=false;
  document.getElementById("msgs").scrollTop=9999;
}
</script>
<canvas id="static"></canvas>
<script>
const canvas=document.getElementById("static");
const ctx=canvas.getContext("2d");
function resize(){canvas.width=window.innerWidth;canvas.height=window.innerHeight;}
resize();
window.addEventListener("resize",resize);
let frame=0;
let scanOffset=0;
function drawStatic(){
  frame++;
  if(frame%3!==0){requestAnimationFrame(drawStatic);return;}
  scanOffset=(scanOffset+0.8)%canvas.height;
  const w=canvas.width,h=canvas.height;
  const imageData=ctx.createImageData(w,h);
  const data=imageData.data;
  for(let y=0;y<h;y++){
    // vertical scan band — brighter strip drifting down
    const distFromScan=Math.abs(y-scanOffset);
    const scanBrightness=distFromScan<6?0.18*Math.max(0,(6-distFromScan)/6):0;
    // occasional full horizontal glitch lines
    const isGlitch=Math.random()>0.997;
    for(let x=0;x<w;x++){
      const i=(y*w+x)*4;
      const v=Math.random()>0.5?255:0;
      const rShift=Math.random()>0.85?Math.floor(Math.random()*80):0;
      const gShift=Math.random()>0.92?Math.floor(Math.random()*60):0;
      const bShift=Math.random()>0.88?Math.floor(Math.random()*100):0;
      const base=isGlitch?200:v;
      data[i]=Math.min(255,base+rShift+scanBrightness*255);
      data[i+1]=Math.min(255,base+gShift+scanBrightness*255);
      data[i+2]=Math.min(255,base+bShift+scanBrightness*255);
      data[i+3]=255;
    }
  }
  ctx.putImageData(imageData,0,0);
  requestAnimationFrame(drawStatic);
}
drawStatic();
</script>
